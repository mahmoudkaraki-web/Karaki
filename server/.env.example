# Copy to .env next to this file on the server (it is ignored by git) and run:
#   node --env-file=.env src/index.js
NODE_ENV=production
HOST=127.0.0.1
PORT=4100
# data (the database, photos, voice notes) lives outside the code folder
DATA_DIR=/var/lib/family
PUBLIC_URL=https://family.besmart-me.com
APPLE_BUNDLE_ID=com.besmart.family

# Push (APNs token auth). MAK makes the key on developer.apple.com and copies the .p8 file here.
APNS_KEY_PATH=/etc/family/AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=5TV89KGJVR
# 1 for TestFlight and App Store builds; leave 0 for development builds
APNS_PRODUCTION=1
# 0 hides the message text on the lock screen (shows "New message")
PUSH_PREVIEW=1

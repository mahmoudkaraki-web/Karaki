# Copy to .env next to this file on the server (it is ignored by git) and run:
#   node --env-file=.env src/index.js
NODE_ENV=production
HOST=127.0.0.1
PORT=4100
# data (the database, photos, voice notes) lives outside the code folder
DATA_DIR=/var/lib/karaki
PUBLIC_URL=https://karaki.besmart-me.com
APPLE_BUNDLE_ID=com.besmart.karaki

# Push (APNs token auth): the .p8 key MAK made on developer.apple.com, or the folder it sits in.
# On MAK's laptop that folder is: C:\Users\mahmo\OneDrive - Be Smart Me\Karaki APP\Push Key
# The key id is taken from the file name (AuthKey_<KEYID>.p8) unless APNS_KEY_ID is set.
APNS_KEY_PATH=/etc/karaki/pushkey
# APNS_KEY_ID=
APNS_TEAM_ID=5TV89KGJVR
# 1 for TestFlight and App Store builds; 0 only for development builds
APNS_PRODUCTION=1
# 0 hides the message text on the lock screen (shows "New message")
PUSH_PREVIEW=1

# Calls. The TURN relay (coturn) already runs on the box (MAK set it up on 18 Oct 2026).
# TURN_SECRET and TURN_URLS are NOT set here: they live in /etc/karaki/turn.env (root only),
# which the systemd unit loads before this file.
STUN_URLS=stun:20.74.255.57:3478
# how long a TURN password lasts (seconds): about two hours per call
TURN_TTL_SECONDS=7200
CALL_RING_SECONDS=45
CALL_MAX_PEOPLE=4
